        </outputEntry>
        <outputEntry id="LiteralExpression_1bu771n">
          <text>"If you have any questions regarding this position; please contact our HR team: Anna Keller HR Manager Alpenblick Consulting AG 📧 careers@alpenblick-consulting.ch 📞 +41 44 123 45 67"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1lf3mvd">
