<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="Results_Decision" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <inputData id="InputData_Select_Position" name="Position" />
  <decision id="Decision_Position" name="Position">
    <informationRequirement id="InformationRequirement_1a3dj7y">
      <requiredInput href="#InputData_Select_Position" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1639di0">
      <input id="Input_1" label="Position" biodi:width="192">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>position</text>
        </inputExpression>
        <inputValues id="UnaryTests_1i38ne7">
          <text>"Software Engineer","Business Analyst","ERP Consultant"</text>
        </inputValues>
      </input>
      <output id="Output_1" label="Title" name="title" typeRef="string" biodi:width="192">
        <outputValues id="UnaryTests_00mja28">
          <text>"Software Engineer","Business Analyst","ERP Consultant"</text>
        </outputValues>
      </output>
      <output id="OutputClause_1f120gu" label="Pensum" name="pensum" typeRef="string" biodi:width="192">
        <outputValues id="UnaryTests_12y9gmx">
          <text>"80-100%","60-100%","40-60%"</text>
        </outputValues>
      </output>
      <output id="OutputClause_0l6qz27" label="Address" name="address" typeRef="string" biodi:width="192">
        <outputValues id="UnaryTests_02afb02">
          <text>"Hans-Muster-Strasse 30"</text>
        </outputValues>
      </output>
      <output id="OutputClause_10isykq" label="About the job" name="about the job" typeRef="string" biodi:width="192">
        <outputValues id="UnaryTests_1arj6i3">
          <text>"-Design; develop; and maintain software applications and internal tools -Collaborate with cross-functional teams to deliver technical solutions -Analyze requirements and translate them into efficient code -Test; debug; and optimize existing systems -Support innovation through modern technologies and best practices","-Analyze business processes and identify improvement opportunities -Gather and document business requirements from stakeholders -Translate business needs into clear functional specifications -Support project implementation and change management activities -Act as a bridge between business teams and technical departments","-Implement and optimize ERP systems for business clients -Analyze client requirements and configure suitable ERP solutions -Train users and support system adoption across departments -Provide troubleshooting and continuous improvement recommendations -Collaborate with project teams to ensure successful deployments"</text>
        </outputValues>
      </output>
      <output id="OutputClause_1cm9swq" label="Your mission" name="your mission" typeRef="string">
        <outputValues id="UnaryTests_0bmiwf0">
          <text>"-Develop high-quality software solutions tailored to business needs -Improve existing applications and system performance -Contribute to digital transformation projects -Ensure reliable and secure software operations -Work closely with internal teams and stakeholders","-Evaluate and improve business processes and workflows -Support requirement engineering and project planning -Deliver insights based on data and stakeholder input -Ensure alignment between business goals and solutions -Support successful implementation of strategic initiatives","-Lead ERP implementation and optimization projects -Support clients in process digitalization initiatives -Configure systems according to operational needs -Provide training and post-go-live support -Build long-term client relationships through excellent service"</text>
        </outputValues>
      </output>
      <output id="OutputClause_07sbfmh" label="Your profile" name="your profile" typeRef="string" biodi:width="192">
        <outputValues id="UnaryTests_07dvu5f">
          <text>"-Degree in Computer Science or related field -Experience in software development and programming languages -Analytical mindset and problem-solving skills -Team-oriented with strong communication abilities -Fluent in English; German is a plus","-Degree in Business Administration; IT; or related field -Experience in business analysis or consulting -Strong analytical and communication skills -Structured and solution-oriented working style -Fluent in English; German is a plus","-Degree in Business Informatics; IT; or related field -Experience with ERP systems and consulting projects -Strong understanding of business processes -Customer-focused and proactive mindset -Fluent in English; German is a plus"</text>
        </outputValues>
      </output>
      <output id="OutputClause_0ugosls" label="Your benefits" name="your benefits" typeRef="string">
        <outputValues id="UnaryTests_1kvp4tv">
          <text>"-Competitive salary and performance-based incentives -Flexible working hours and hybrid work options -Modern workplace with up-to-date technology -Opportunities for professional development and training -Flat hierarchies and short decision-making paths -Supportive and collaborative team culture -Exciting projects with diverse clients and industries -Central office location in Switzerland"</text>
        </outputValues>
      </output>
      <output id="OutputClause_1lcja9z" label="Contact person" name="contact person" typeRef="string" biodi:width="192">
        <outputValues id="UnaryTests_1f60q7f">
          <text>"If you have any questions regarding this position; please contact our HR team: Anna Keller HR Manager Alpenblick Consulting AG 📧 careers@alpenblick-consulting.ch 📞 +41 44 123 45 67"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_11u6e44">
        <inputEntry id="UnaryTests_0exf7pi">
          <text>"Software Engineer"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0sdu0fj">
          <text>"Software Engineer"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_10al4a8">
          <text>"80-100%"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0d9nv5j">
          <text>"Hans-Muster-Strasse 30"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1ic1rey">
          <text>"-Design; develop; and maintain software applications and internal tools -Collaborate with cross-functional teams to deliver technical solutions -Analyze requirements and translate them into efficient code -Test; debug; and optimize existing systems -Support innovation through modern technologies and best practices"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_03ul78c">
          <text>"-Develop high-quality software solutions tailored to business needs
-Improve existing applications and system performance
-Contribute to digital transformation projects
-Ensure reliable and secure software operations
-Work closely with internal teams and stakeholders"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_05aj1zn">
          <text>"-Degree in Computer Science or related field -Experience in software development and programming languages -Analytical mindset and problem-solving skills -Team-oriented with strong communication abilities -Fluent in English; German is a plus"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1f8xktk">
