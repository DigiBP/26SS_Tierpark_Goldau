      <bpmn:messageEventDefinition id="MessageEventDefinition_1bsyump" messageRef="Message_3kaealr" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_CollectApp" name="Collect &#38; Structure Application" camunda:modelerTemplate="onl.mrtn.camunda.http.api_connect" camunda:modelerTemplateVersion="2" camunda:delegateExpression="${api_connect}">
