    <bpmn:messageFlow id="Flow_1jb6fbh" name="Application submission" sourceRef="Participant_0efe23m" targetRef="Event_AppReceived" />
    <bpmn:messageFlow id="Flow_0l16vzw" name="Cancellation" sourceRef="Activity_SendCancellation" targetRef="Participant_0efe23m" />
    <bpmn:messageFlow id="Flow_18o45yf" name="Interview invitation" sourceRef="Activity_InviteInterview" targetRef="Participant_0efe23m" />
