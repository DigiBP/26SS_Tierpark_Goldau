        <bpmn:flowNodeRef>Activity_InviteInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_InterviewScheduled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0n5nf8f" name="Hiring Manager" />
    </bpmn:laneSet>
    <bpmn:businessRuleTask id="Activity_ScoreCV" name="Score CV Automatically" camunda:resultVariable="cvScore" camunda:decisionRef="Decision_CVScore" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_0ll9fvo</bpmn:incoming>
      <bpmn:outgoing>Flow_01o068q</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Score" name="Score &#62;= 50?">
      <bpmn:incoming>Flow_01o068q</bpmn:incoming>
      <bpmn:outgoing>Flow_gateway_cancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_gateway_invite</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_AppDenied" name="Application denied">
      <bpmn:incoming>Flow_1grh3u8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0qj575m" sourceRef="Event_AppReceived" targetRef="Activity_CollectApp" />
    <bpmn:sequenceFlow id="Flow_0ll9fvo" sourceRef="Activity_CollectApp" targetRef="Activity_ScoreCV" />
    <bpmn:sequenceFlow id="Flow_01o068q" sourceRef="Activity_ScoreCV" targetRef="Gateway_Score" />
    <bpmn:sequenceFlow id="Flow_gateway_cancel" name="No" sourceRef="Gateway_Score" targetRef="Activity_SendCancellation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cvScore &lt; 45}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gateway_invite" name="Yes" sourceRef="Gateway_Score" targetRef="Activity_InviteInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cvScore &gt;= 45}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1grh3u8" sourceRef="Activity_SendCancellation" targetRef="Event_AppDenied" />
    <bpmn:startEvent id="Event_AppReceived" name="Application received">
