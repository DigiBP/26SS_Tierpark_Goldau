  <bpmn:process id="Process_diagram_5" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1r963d3">
      <bpmn:lane id="Lane_0w8q9mt" name="HR Manager">
        <bpmn:flowNodeRef>Event_AppReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CollectApp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_13ip1q7" name="System">
        <bpmn:flowNodeRef>Activity_ScoreCV</bpmn:flowNodeRef>
