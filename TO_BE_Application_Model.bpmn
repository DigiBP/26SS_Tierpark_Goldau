    <bpmn:scriptTask id="Activity_0camid1" name="Generate Job ID" scriptFormat="javascript">
      <bpmn:incoming>Flow_0rk2loa</bpmn:incoming>
      <bpmn:outgoing>Flow_0ya2bhn</bpmn:outgoing>
      <bpmn:script>var title = execution.getVariable("Decision_Results").title;

var words = title.split(" ");
var prefix = "";
for (var i = 0; i &lt; words.length; i++) {
  prefix += words[i].charAt(0).toUpperCase();
}

var now = new Date();
var year  = now.getFullYear();
var month = ("0" + (now.getMonth() + 1)).slice(-2);
var day   = ("0" + now.getDate()).slice(-2);
var date  = "" + year + month + day;

var rand = Math.floor(Math.random() * 900) + 100;

var jobId = prefix + "-" + date + "-" + rand;

execution.setVariable("jobId", jobId);</bpmn:script>
    </bpmn:scriptTask>
