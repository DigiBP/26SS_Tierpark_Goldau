  <bpmn:process id="Process_Job_Posting" isExecutable="true">
    <bpmn:businessRuleTask id="Activity_0fit2jv" name="Decide on position" camunda:resultVariable="Decision_Results" camunda:decisionRef="Decision_Position" camunda:decisionRefBinding="deployment" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="resultVariable" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04cux73</bpmn:incoming>
      <bpmn:outgoing>Flow_0rk2loa</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:startEvent id="Event_0qepplw" name="New position requested" camunda:formRef="Form_Position" camunda:formRefBinding="deployment">
      <bpmn:outgoing>Flow_04cux73</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Activity_0camid1" name="Generate Job ID" scriptFormat="javascript">
      <bpmn:incoming>Flow_0rk2loa</bpmn:incoming>
      <bpmn:outgoing>Flow_0ya2bhn</bpmn:outgoing>
      <bpmn:script>var title = execution.getVariable("Decision_Results").title;

var words = title.split(" ");
var prefix = "";
for (var i = 0; i &lt; words.length; i++) {
  prefix += words[i].charAt(0).toUpperCase();
}

var now = new Date();
var year  = now.getFullYear();
var month = ("0" + (now.getMonth() + 1)).slice(-2);
var day   = ("0" + now.getDate()).slice(-2);
var date  = "" + year + month + day;

var rand = Math.floor(Math.random() * 900) + 100;

var jobId = prefix + "-" + date + "-" + rand;

execution.setVariable("jobId", jobId);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_116b4kh" name="Send decision to Make (Google Sheets)" camunda:delegateExpression="${api_connect}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="api_connect_api_variables" />
          <camunda:inputParameter name="api_connect_result_variables" />
        </camunda:inputOutput>
        <camunda:field name="api_connect_url">
          <camunda:string>https://hook.eu1.make.com/3e2wmrwckxvwm8l5jqtcjrcu1ujhqtka</camunda:string>
        </camunda:field>
        <camunda:field name="api_connect_authorization">
          <camunda:string>None</camunda:string>
        </camunda:field>
        <camunda:field name="api_connect_api_variables">
          <camunda:string>true</camunda:string>
        </camunda:field>
        <camunda:field name="api_connect_result_variables">
          <camunda:string>true</camunda:string>
        </camunda:field>
        <camunda:field name="api_connect_result_variable">
          <camunda:string>None</camunda:string>
        </camunda:field>
        <camunda:field name="api_connect_verbosity_outgoing">
          <camunda:string>plain</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ya2bhn</bpmn:incoming>
      <bpmn:outgoing>Flow_1xtneqp</bpmn:outgoing>
    </bpmn:serviceTask>
